# Start the managents helper at login (Linux, systemd user unit).
# Replace %h/.local/bin/managents with the path of your binary, then:
#   cp managents.service ~/.config/systemd/user/
#   systemctl --user enable --now managents
# Your user needs access to the serial port (usually the "dialout" or "uucp" group).

[Unit]
Description=managents helper: AI agent status on a USB display

[Service]
ExecStart=%h/.local/bin/managents run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
